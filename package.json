{
  "name": "housekeeper",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "PWA multi-tenant para la relación laboral y la operación doméstica.",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "backup:full": "pnpm --filter @housekeeper/worker backup:full",
    "build": "pnpm -r --if-present build",
    "check": "pnpm -r --if-present check",
    "db:migrate": "pnpm --filter @housekeeper/db migrate",
    "dev": "pnpm --filter @housekeeper/web dev",
    "lint": "eslint .",
    "manual:publicar": "node scripts/construir-manual-publicable.mjs",
    "test": "pnpm -r --if-present test",
    "test:coverage": "pnpm -r --if-present test:coverage",
    "test:db": "pnpm --filter @housekeeper/db test:db",
    "test:a11y": "pnpm --filter @housekeeper/web test:a11y",
    "test:e2e": "pnpm --filter @housekeeper/web test:e2e",
    "test:e2e:db": "pnpm --filter @housekeeper/web test:e2e:db",
    "test:import": "pnpm --filter @housekeeper/db test:import",
    "test:lighthouse": "lhci autorun --config=infra/quality/lighthouserc.json",
    "test:rls": "pnpm --filter @housekeeper/db test:rls",
    "test:unit": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify:bundle": "pnpm --filter @housekeeper/web verify:bundle"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "0.15.1",
    "@types/node": "24.3.1",
    "eslint": "^10.9.1",
    "globals": "^15.15.0",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "overrides": {
      "nanoid@<3.3.18": "^3.3.18"
    }
  }
}
