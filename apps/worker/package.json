{
  "name": "@casa-clara/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./jobs": "./src/jobs.ts"
  },
  "scripts": {
    "backup:full": "node scripts/full-backup.mjs",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "pnpm --filter @casa-clara/server build && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1105.0",
    "@casa-clara/server": "workspace:*",
    "fflate": "0.8.3",
    "nodemailer": "9.0.4",
    "pdf-lib": "1.17.1",
    "pg": "8.22.0",
    "sharp": "0.35.3",
    "tesseract.js": "7.0.0",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/node": "24.3.1",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.20.4",
    "@types/web-push": "3.6.4",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
