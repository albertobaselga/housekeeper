{
  "name": "@housekeeper/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/check-deployment-config.mjs && vite build && node scripts/verify-fixture-login.mjs",
    "verify:bundle": "node scripts/verify-today-bundle.mjs",
    "preview": "vite preview",
    "seed:accounts": "node scripts/seed-household-accounts.mjs",
    "start": "node build",
    "check": "node scripts/lint-css-tokens.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint:css": "node scripts/lint-css-tokens.mjs",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:a11y": "PLAYWRIGHT_JUNIT_OUTPUT_NAME=../../artifacts/e2e/junit-a11y.xml playwright test --project=a11y",
    "test:e2e": "playwright test --project=e2e",
    "test:e2e:db": "E2E_DATABASE_URL=${E2E_DATABASE_URL:-postgresql://casa_admin@127.0.0.1:54329/housekeeper_wt_u} playwright test --config=playwright.db.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1105.0",
    "@housekeeper/contracts": "workspace:*",
    "@housekeeper/domain": "workspace:*",
    "@housekeeper/server": "workspace:*",
    "@housekeeper/worker": "workspace:*",
    "@milkdown/kit": "7.22.0",
    "better-auth": "1.6.26",
    "fflate": "0.8.3",
    "ical-generator": "11.1.0",
    "pdf-lib": "1.17.1",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/adapter-vercel": "6.3.4",
    "@sveltejs/kit": "2.70.2",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@types/pg": "8.20.4",
    "fake-indexeddb": "6.2.5",
    "svelte": "5.56.8",
    "svelte-check": "4.7.5",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.11"
  }
}
