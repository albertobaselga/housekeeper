# Entorno sintético: copiar a staging.env, sustituir todos los valores y no versionar el resultado.
RELEASE_TAG=staging-20260807
STAGING_HOST=staging.casaclara.test
POSTGRES_USER=casaclara_staging
POSTGRES_PASSWORD=replace-with-random-staging-value
POSTGRES_DB=casaclara_staging
APP_DB_PASSWORD=replace-with-url-safe-random-app-value
WORKER_DB_PASSWORD=replace-with-url-safe-random-worker-value
AUTH_DB_PASSWORD=replace-with-url-safe-random-auth-value
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
MINIO_ROOT_USER=casaclara-staging
MINIO_ROOT_PASSWORD=replace-with-random-object-storage-value
S3_BUCKET=casaclara-staging
SMTP_FROM=Casa Clara staging <no-reply@casaclara.test>
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-random-observability-value
CADDY_HTTP_PORT=8081
CADDY_HTTPS_PORT=8443
WEB_HEALTH_PATH=/api/health
