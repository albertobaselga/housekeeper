# Valores exclusivamente locales y sintéticos. No contienen secretos reutilizables.
POSTGRES_USER=casaclara
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=casaclara
APP_DB_PASSWORD=local-app-only
WORKER_DB_PASSWORD=local-worker-only
AUTH_DB_PASSWORD=local-auth-only
BETTER_AUTH_SECRET=local-better-auth-secret-change-before-use
# Contraseña demo solo en local; en staging queda deshabilitada y se usa magic link.
ENABLE_DEMO_PASSWORD_AUTH=true
# Para sembrar las cinco cuentas demo (pnpm --filter @casa-clara/web seed:demo)
# se necesita además SEED_DATABASE_URL con el propietario de las migraciones.
MINIO_ROOT_USER=casaclara-local
MINIO_ROOT_PASSWORD=local-object-storage-only
S3_BUCKET=casaclara-local
SMTP_FROM=Casa Clara local <no-reply@casaclara.test>
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-observability-only
CADDY_HTTP_PORT=8080
WEB_HEALTH_PATH=/api/health
