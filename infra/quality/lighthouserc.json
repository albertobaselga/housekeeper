{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm --filter @casa-clara/web build && env PORT=3000 node apps/web/build",
      "startServerReadyPattern": "Listening on",
      "startServerReadyTimeout": 240000,
      "url": [
        "http://127.0.0.1:3000/login",
        "http://127.0.0.1:3000/offline"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "throttlingMethod": "simulate",
        "budgetsPath": "infra/quality/lighthouse-budget.json"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 1 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2000 }],
        "total-blocking-time": ["error", { "maxNumericValue": 200 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 122880 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "artifacts/lighthouse"
    }
  }
}
