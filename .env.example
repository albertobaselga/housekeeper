# =============================================================================
# Casa Clara — inventario COMPLETO de variables de entorno
# =============================================================================
#
# Este fichero no es un `.env` que copiar entero a ningún sitio: es el mapa de
# todas las variables que el sistema lee, con su destino. Ningún valor de aquí
# sirve en producción; los de demostración son deliberadamente sintéticos.
#
# Cada bloque dice DÓNDE va cada variable:
#
#   [local]   demo en el portátil (`node build`, `pnpm dev`) y Compose local
#   [vercel]  variables del proyecto de la web en Vercel
#   [worker]  host aparte donde corre apps/worker y el antivirus
#   [ops]     solo en la máquina de quien administra (migraciones, copias)
#   [ci]      solo en los workflows
#
# Y su carácter:
#
#   OBLIGATORIA  sin ella ese componente no funciona (o degrada en silencio)
#   OPCIONAL     tiene valor por omisión razonable
#   NO DEFINIR   definirla en producción enciende un camino que no debe estar
#
# Los booleanos se comparan CONTRA LA CADENA 'true' exactamente: `TRUE`, `1` o
# `yes` cuentan como falso.
#
# Referencias: docs/despliegue/runbook-despliegue.md (pasos de punta a punta) y
# docs/despliegue/plan-vercel-supabase.md (por qué cada decisión).
# -----------------------------------------------------------------------------


# -----------------------------------------------------------------------------
# 1. Base de datos
# -----------------------------------------------------------------------------

# REGLA INDIVISIBLE: DATABASE_URL, DATABASE_AUTH_URL, BETTER_AUTH_SECRET y
# BETTER_AUTH_URL entran en la MISMA operación o no entra ninguna. Media
# configuración es peor que ninguna: con la base puesta y la identidad a medias
# nadie podría entrar con su contraseña y lo único que quedaría en pie sería el
# camino sintético sobre datos reales. La aplicación ya no admite ese estado —ni
# la build ni el arranque—, y dice exactamente qué falta.
# Ver docs/adr/0003-configuracion-indivisible-y-cuentas-sinteticas.md.

# OBLIGATORIA [vercel] [local] — rol `casa_clara_app_login`.
# En Vercel va por el POOLER de Supabase en modo transacción (puerto 6543):
# cada instancia efímera abre su propio pool y la conexión directa se agotaría.
# Todo el código de la app es transaccional (`set_config(..., true)` y
# `pg_advisory_xact_lock`), así que el pooler es compatible.
DATABASE_URL=postgresql://casa_clara_app_login:CAMBIAME@db.PROYECTO.supabase.co:6543/postgres

# OBLIGATORIA [vercel] [worker] — rol `casa_clara_worker_login`. El worker es un
# proceso fijo: le vale tanto el pooler (6543) como la conexión directa (5432).
# WORKER_DATABASE_URL se llama DATABASE_URL dentro del contenedor del worker;
# el nombre distinto es solo para no confundir los dos roles en el mismo .env.
#
# En Vercel la necesita el drenaje de la cola (§6b): `app_private.job_queue` no
# tiene NI UN GRANT para `casa_clara_app` (migración 0005), así que ese endpoint
# abre su propia conexión con el rol del worker. Poner aquí la cadena de la
# aplicación no degrada nada en silencio: falla con «permission denied».
WORKER_DATABASE_URL=postgresql://casa_clara_worker_login:CAMBIAME@db.PROYECTO.supabase.co:6543/postgres

# OBLIGATORIA [vercel] [local] — Better Auth, rol `casa_clara_auth_login`, cuyo
# `search_path` apunta al esquema `casa_auth` (en Supabase el esquema `auth`
# pertenece a GoTrue y no se puede usar).
DATABASE_AUTH_URL=postgresql://casa_clara_auth_login:CAMBIAME@db.PROYECTO.supabase.co:6543/postgres

# OBLIGATORIA [ops] — CONEXIÓN DIRECTA (5432) con el rol propietario.
# La usan `pnpm db:migrate` (toma un `pg_advisory_lock` de SESIÓN, que el
# pooler en modo transacción no conserva), el importador del manual (hace
# `set local row_security = off`) y `pnpm backup:full`.
# NUNCA se configura en Vercel ni en el worker.
BACKUP_DATABASE_URL=postgresql://postgres:CAMBIAME@db.PROYECTO.supabase.co:5432/postgres


# -----------------------------------------------------------------------------
# 2. Autenticación y firma
# -----------------------------------------------------------------------------

# OBLIGATORIA [vercel] [local] — al menos 32 bytes aleatorios.
#   openssl rand -base64 48
BETTER_AUTH_SECRET=cambiame-por-al-menos-32-bytes-aleatorios

# OBLIGATORIA [vercel] — dominio REAL del despliegue. Su valor por omisión es
# `http://localhost:3000`, que es la base sobre la que Better Auth emite y
# valida las cookies de sesión: dejarlo puesto en un dominio real rompe la
# sesión de todo el mundo. Con DATABASE_URL configurada, la aplicación exige que
# sea `https` (o un nombre local) y no arranca si no lo es.
BETTER_AUTH_URL=https://casa.ejemplo.es

# OBLIGATORIA [vercel] — clave Ed25519 (PEM PKCS8 en base64) que firma los
# snapshots offline. En autogestionado es «recomendable»; en serverless es
# OBLIGATORIA: sin ella cada instancia genera una clave efímera propia y el
# snapshot deja de verificar entre invocaciones.
#   openssl genpkey -algorithm ed25519 | base64 -w0
SNAPSHOT_SIGNING_KEY_B64=cambiame-por-el-base64-del-pem-ed25519


# -----------------------------------------------------------------------------
# 3. Almacén de adjuntos
# -----------------------------------------------------------------------------
# Hay DOS caminos y la web elige solo: si hay clave de servicio de Supabase usa
# Supabase Storage por su API REST; si no, usa S3 con las S3_*. Sin ninguno de
# los dos, adjuntar responde 503 con un mensaje veraz.
#
# EL BUCKET ES PRIVADO SIEMPRE. La app sirve los justificantes proxeándolos por
# una ruta autenticada que comprueba sesión y pertenencia; ningún objeto se
# expone en público, ni por URL firmada ni por política de bucket.

# --- 3a. Supabase Storage (el despliegue real: Vercel + Supabase) ------------
# Se prefiere a la compatibilidad S3 del mismo Storage porque esta clave YA
# EXISTE en el proyecto —basta copiarla— mientras que las credenciales S3 hay
# que crearlas a mano. El bucket lo crea la propia app, privado, en la primera
# subida: tampoco hay que pasar por el panel para eso.

# OBLIGATORIA [vercel] — Supabase → Project Settings → API Keys. Sirve tanto la
# `service_role` clásica (JWT) como la nueva `sb_secret_…`; el nombre alternativo
# SUPABASE_SECRET_KEY también se lee. ES UNA CLAVE DE SERVICIO: salta la RLS de
# Storage y no puede llegar al navegador bajo ningún concepto.
SUPABASE_SERVICE_ROLE_KEY=cambiame

# OPCIONAL — raíz del proyecto. Si no se declara, se deduce de DATABASE_URL
# (`db.<ref>.supabase.co` o el usuario `postgres.<ref>` del pooler). Declararla
# manda sobre lo deducido.
# SUPABASE_URL=https://PROYECTO.supabase.co

# OPCIONAL — por omisión `casaclara` (o S3_PRIVATE_BUCKET si está definida).
# SUPABASE_STORAGE_BUCKET=casaclara

# --- 3b. S3 (Compose local y staging con MinIO; también el worker) -----------
# El SDK de S3 se carga bajo demanda: en el camino de Supabase no se evalúa y no
# se paga en el arranque en frío de la función.
# Solo se usan tres operaciones: PutObject, GetObject y (en las copias)
# ListObjectsV2, con `forcePathStyle: true` cableado.

# OBLIGATORIAS [worker] [ops]; en [vercel] solo si NO se usa 3a
S3_ENDPOINT=https://PROYECTO.supabase.co/storage/v1/s3
S3_PRIVATE_BUCKET=casaclara
S3_ACCESS_KEY_ID=cambiame
S3_SECRET_ACCESS_KEY=cambiame

# OPCIONAL (por omisión `eu-west-1`) — debe ser la región REAL del proyecto,
# porque entra en la firma SigV4. ADR 0001: siempre una región de la UE.
S3_REGION=eu-central-1


# -----------------------------------------------------------------------------
# 4. Antivirus (ClamAV) — OPCIONAL
# -----------------------------------------------------------------------------
# NO está activo en producción: Vercel + Supabase no tiene dónde correr un
# demonio. Sin CLAMAV_HOST los adjuntos funcionan igual, solo que sin escanear;
# el riesgo asumido y cómo reactivarlo están en
# docs/security/adjuntos-sin-antivirus.md.
#
# Con CLAMAV_HOST definida se escanea cada subida: un positivo devuelve 422 y no
# deja rastro; un antivirus caído devuelve 503 con un mensaje veraz, y el cambio
# que esperaba la foto acaba en el triaje del dispositivo. Nunca se asume
# «limpio» ni se queda una foto atascada en silencio.

# OPCIONAL [vercel] [local] — nombre público de la pasarela de infra/clamav
# (en Compose local, simplemente `clamav`). Definirla ENCIENDE el escaneo.
CLAMAV_HOST=antivirus.ejemplo.es
# OPCIONAL (3310 en Compose; 3311 es el puerto de la pasarela con TLS)
CLAMAV_PORT=3311

# OBLIGATORIAS [vercel] cuando SE USA el antivirus y NO está en la red privada
# de la web.
# clamd no tiene autenticación propia: publicar su puerto en abierto sería
# regalar escaneo y una vía de tumbar el antivirus, así que delante va la
# pasarela de infra/clamav, que exige TLS y este token compartido.
# En Compose local se dejan SIN DEFINIR (red interna, sin TLS).
#   openssl rand -hex 32
CLAMAV_TLS=true
CLAMAV_TOKEN=cambiame-por-32-bytes-hex
# OPCIONAL — PEM de la CA cuando el certificado de la pasarela lo emite una
# autoridad propia. La verificación del certificado NUNCA se apaga.
# CLAMAV_TLS_CA_PEM=

# [worker] — el MISMO valor de CLAMAV_TOKEN, más el par TLS de la pasarela.
CLAMAV_GATEWAY_TOKEN=cambiame-por-32-bytes-hex
CLAMAV_GATEWAY_CERT=/etc/casaclara/tls/fullchain.pem
CLAMAV_GATEWAY_KEY=/etc/casaclara/tls/privkey.pem
# OPCIONALES
CLAMAV_GATEWAY_PORT=3311
CLAMAV_UPSTREAM_HOST=127.0.0.1
CLAMAV_UPSTREAM_PORT=3310
CLAMAV_TLS_DIR=/etc/casaclara/tls


# -----------------------------------------------------------------------------
# 5. Correo — NO HAY (migración 0029)
# -----------------------------------------------------------------------------
# Aquí vivían SMTP_HOST, SMTP_FROM y SMTP_PORT. Ya no existen: la aplicación no
# manda correo a nadie. El canal es la aplicación, y el acceso es por nombre y
# contraseña, así que tampoco hay enlace mágico que entregar.
#
# Si estas variables siguen puestas en el panel de un despliegue anterior, se
# BORRAN. Nadie las lee, y dejarlas hace creer que hay un canal de aviso que no
# existe. El canal que sí existe es el de §5b.


# -----------------------------------------------------------------------------
# 5b. Avisos en el móvil (Web Push) — OPCIONALES, y las tres o ninguna
# -----------------------------------------------------------------------------
# DOS avisos, y ninguno más: el recibo del mes a quien trabaja en la casa, y la
# cuenta del mes por pagar a quien administra. Lo que queda prohibido notificar
# —tareas, recuentos, presencia, ausencia de acción— y por qué, en
# docs/notificaciones.md §6. No es una lista de opciones apagadas: es código que
# no existe, y hay pruebas que lo sostienen.
#
# Sin estas variables la aplicación funciona ENTERA: no se encola ningún aviso,
# no se registra su manejador, la cola se vacía igual y «Tu cuenta» dice que esta
# instalación no manda avisos en vez de dibujar un interruptor que no puede
# funcionar. Nada vive solo detrás del push.
#
# Las claves NO están en el repositorio y no pueden estarlo. Se generan con:
#   pnpm --filter @casa-clara/worker exec web-push generate-vapid-keys --json
# y el procedimiento completo —custodia, rotación, la trampa del `sub` de Apple,
# y la cadena de iOS— está en docs/runbooks/notificaciones-push.md.
#
# Rotarlas invalida TODAS las suscripciones a la vez y obliga a volver a
# suscribir a cada persona con su teléfono delante. No se rotan por higiene.

# OBLIGATORIAS [vercel] [worker] CUANDO SE QUIERAN AVISOS; las tres juntas.
# Con la pública puesta y la privada a medias, el navegador se suscribiría a un
# servidor que jamás podrá escribirle: el silencio se leería como «está roto» en
# vez de como «no está configurado».
VAPID_PUBLIC_KEY=cambiame-por-la-clave-publica-generada
VAPID_PRIVATE_KEY=cambiame-por-la-clave-privada-generada

# `mailto:` o `https:` LIMPIO: sin espacios, sin corchetes angulares, con dominio
# válido. Apple contesta 403 BadJwtToken a un `sub` sucio, y SOLO Apple, así que
# un espacio de más rompe los avisos únicamente en los iPhone de la casa. La
# aplicación valida el formato al arrancar y, si no pasa, se comporta como si no
# hubiera claves.
VAPID_SUBJECT=mailto:avisos@ejemplo.es


# -----------------------------------------------------------------------------
# 6. Worker (demonio en host propio)
# -----------------------------------------------------------------------------
# Todas OPCIONALES; el worker valida al arrancar y muere con «Falta la variable
# <KEY>» si le falta algo obligatorio (DATABASE_URL y las S3_*).
WORKER_HEALTH_PORT=3001
# WORKER_MAX_JOB_ATTEMPTS la leen los DOS ejecutores (el demonio y el drenaje
# de §6b): es el mismo presupuesto de reintentos sobre la misma cola.
WORKER_MAX_JOB_ATTEMPTS=5
WORKER_POLL_INTERVAL_MS=1000


# -----------------------------------------------------------------------------
# 6b. Drenaje de la cola desde la web (pg_cron + pg_net → Vercel)
# -----------------------------------------------------------------------------
# La alternativa al demonio de §6 cuando no hay host propio: `pg_cron` llama
# cada pocos minutos a POST /api/v1/jobs/run y ese endpoint vacía la cola con
# los MISMOS manejadores del worker. Pasos exactos y SQL del planificador en
# docs/runbooks/planificador-cola.md.
#
# El endpoint necesita, además de esto, WORKER_DATABASE_URL (§1) y UN ALMACÉN de
# §3 —cualquiera de los dos caminos: la clave de servicio de Supabase o las
# S3_*—, porque de ahí sale el PDF del recibo. Si falta responde 503 y NO toca
# la cola: un drenaje a medias mandaría los recibos a `dead` por falta de
# almacén, en silencio.
#
# Es el MISMO almacén que usan los adjuntos y lo elige la misma función, así que
# no hay que declarar nada dos veces. Exigir aquí las cuatro S3_* por separado
# tenía la cola parada en el despliegue recomendado, que solo tiene la clave de
# Supabase; era el mismo defecto que tuvo con SMTP_HOST.

# OBLIGATORIA [vercel] para el drenaje — secreto compartido que viaja en la
# cabecera `x-casa-clara-job-token`. El MISMO valor va al Vault de Supabase
# (`vault.create_secret(..., 'casa_clara_job_runner_token')`), nunca al SQL del
# cron: `cron.job` y `cron.job_run_details` guardan el comando en texto plano.
#   openssl rand -hex 32
JOB_RUNNER_TOKEN=cambiame-por-32-bytes-hex

# OPCIONAL (8000) — presupuesto de una pasada, en ms. El plan gratuito de Vercel
# corta la función a los 10 s; el bucle mira el reloj ENTRE trabajos y deja lo
# que sobre para la pasada siguiente, nunca a medias.
JOB_RUNNER_BUDGET_MS=8000

# OPCIONAL (300000) — arriendo de un trabajo reclamado, en ms. Pasado ese
# tiempo, una fila que siga en `running` se da por abandonada (su ejecutor
# desapareció) y vuelve a la cola, o pasa a `dead` si ya agotó sus intentos.
JOB_RUNNER_LEASE_MS=300000


# -----------------------------------------------------------------------------
# 7. Build y despliegue de la web
# -----------------------------------------------------------------------------

# OPCIONAL — objetivo del adaptador EN TIEMPO DE BUILD. Sin declarar, `vercel`
# si la build corre en Vercel (la plataforma exporta `VERCEL`) y `node` en el
# resto (demo local, imágenes de infra/docker, e2e). Declararla fuerza el
# objetivo en ambos sentidos; un valor desconocido falla el build en vez de
# degradar a node. No hace falta ponerla en el proyecto de Vercel.
# DEPLOY_TARGET=vercel
# OPCIONALES — solo con el objetivo `vercel`.
VERCEL_DEPLOY_REGION=fra1
VERCEL_NODE_RUNTIME=nodejs24.x
VERCEL_MAX_DURATION=60

# [local] — adapter-node los lee para saber dónde escuchar y contra qué
# comparar el origen en la comprobación CSRF. En Vercel NO EXISTEN: la región,
# el puerto y el host los pone la plataforma, y el origen se deriva de
# `x-forwarded-host`.
HOST=127.0.0.1
PORT=4173
# ORIGIN=https://casa.ejemplo.es


# -----------------------------------------------------------------------------
# 8. Copias de seguridad manuales
# -----------------------------------------------------------------------------
# `pnpm backup:full` copia base + adjuntos de una vez, verifica el dump con
# `pg_restore --list`, escribe SHA256SUMS y un manifiesto, y solo entonces da
# el directorio por bueno. No programa nada: son copias a demanda.
# Necesita BACKUP_DATABASE_URL (§1) y las S3_* (§3).
BACKUP_DIR=artifacts/backups
# OPCIONALES — rutas de los binarios si no están en el PATH.
# PG_DUMP=/usr/lib/postgresql/18/bin/pg_dump
# PG_RESTORE=/usr/lib/postgresql/18/bin/pg_restore


# -----------------------------------------------------------------------------
# 9. Banderas que NO deben definirse en producción
# -----------------------------------------------------------------------------

# NO DEFINIR [vercel] [worker]. Declara el entorno como solo-sintético: «aquí
# no hay datos reales». Pinta el banner permanente y hace que el worker rechace
# todo destinatario de correo que no sea de un dominio reservado de prueba.
#
# Ya no es sólo un cartel: si la afirmación es falsa, cuesta el despliegue. Con
# VERCEL_ENV=production la aplicación NO ARRANCA, y la build de producción la
# rechaza por existir —ni siquiera a "false"—, porque una variable presente en
# el panel es una variable que alguien puede voltear un martes. La ausencia es
# el único estado que no se voltea por accidente. Razonamiento completo en
# docs/adr/0003-configuracion-indivisible-y-cuentas-sinteticas.md.
#
# Comprobación: `curl https://…/api/health` tiene que devolver "synthetic":false.
# ALLOW_SYNTHETIC_DATA_ONLY=true

# NO DEFINIR [build]. Mete el selector de cuentas sintéticas DENTRO del paquete.
# Sin declararla, `vite build` lo deja fuera y `?/demo` responde 404 porque no
# existe ninguna acción con ese nombre; `vite dev` sí lo lleva, de modo que el
# desarrollo local sin base de datos no necesita declarar nada. Sus dos únicos
# consumidores legítimos son playwright.config.ts y playwright.db.config.ts.
#
# Comprobación: `curl https://…/api/health` tiene que devolver "fixtureLogin":false.
# CASA_CLARA_FIXTURE_LOGIN=true

# Conexión con la que siembran cuentas los guiones de apoyo
# (`apps/web/scripts/seed-household-accounts.mjs` y
# `manual-shots-accounts.mjs`). No la lee la aplicación.
#
# (`ENABLE_DEMO_PASSWORD_AUTH` estaba documentada aquí y NO EXISTE en el código:
# ningún fichero de apps/ ni de packages/ la lee. La puerta que sí existía era
# el selector de cuentas sintéticas, y hoy la cierra CASA_CLARA_FIXTURE_LOGIN en
# tiempo de compilación.)
#
# Las variables DEMO_* de las cinco cuentas vivían aquí y se retiraron el
# 12/08/2026: sus únicos lectores eran el prototipo de la raíz y su batería, que
# ya no están (tags demo-v0.1.0 y demo-v0.1.1). Las cuentas de demostración de
# hoy son de código, no de entorno: apps/web/src/lib/server/fixtures.server.ts.
# SEED_DATABASE_URL=


# -----------------------------------------------------------------------------
# 10. Solo pruebas y CI
# -----------------------------------------------------------------------------
# TEST_DATABASE_URL=          # suites SQL/RLS y tests de integración
# E2E_DATABASE_URL=           # Playwright con base de datos
# E2E_PORT=4173               # puerto del servidor de e2e
# E2E_SHOT_DIR=               # capturas del manual
# PLAYWRIGHT_JUNIT_OUTPUT_NAME=
# CI=true
# TZ=Europe/Madrid


# -----------------------------------------------------------------------------
# 11. Solo despliegue autogestionado (Docker Compose)
# -----------------------------------------------------------------------------
# Ninguna de estas existe en el despliegue Vercel + Supabase; viven en
# infra/env/local.env.example e infra/env/staging.env.example:
#
#   POSTGRES_USER/PASSWORD/DB, APP_DB_PASSWORD, WORKER_DB_PASSWORD,
#   AUTH_DB_PASSWORD, MINIO_ROOT_USER/PASSWORD, S3_BUCKET, CADDY_HTTP_PORT,
#   CADDY_HTTPS_PORT, STAGING_HOST, RELEASE_TAG, GRAFANA_ADMIN_USER/PASSWORD,
#   PROMETHEUS_PORT, BACKUP_RETENTION_DAYS,
#   WEB_HEALTH_PATH, WEB_WORKSPACE_FILTER, WORKER_WORKSPACE_FILTER
